<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>$(UnityLangVersion)</LangVersion>
    <RootNamespace>Walk</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Walk.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="libs/TimelineColumn.cs" LinkBase="Bridge" />
    <None Include="walk.tlb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tl.CSharp" Version="1.3.0" />
    <ProjectReference Include="libs/Kernels/Kernels.csproj" />
    <ProjectReference Include="libs/generator/Kernels.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
