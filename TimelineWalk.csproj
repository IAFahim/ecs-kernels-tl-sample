<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>$(UnityLangVersion)</LangVersion>
    <RootNamespace>Walk</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The generated timeline facades forward through tl's function-pointer registration
         surface: unsafe is part of the tl shape (tl's own targets set it). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Walk.cs" />
    <Compile Include="Program.cs" />
    <None Include="walk.tlb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- tl 1.3.0's own binding generator (Tl.CSharp's analyzer) requires a hand-written
         OnActive in source, which a generated consumer never has; the ecs-kernels
         generator emits the binding itself, so only tl's runtime is referenced. -->
    <PackageReference Include="Tl.Runtime" Version="1.3.0" />
    <ProjectReference Include="libs/Kernels/Kernels.csproj" />
    <ProjectReference Include="libs/generator/Kernels.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
