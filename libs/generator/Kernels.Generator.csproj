<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Kernels.Generator</RootNamespace>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(KernelsRuntimeDirectory)KernelMath.cs" LogicalName="Kernels.KernelMath.cs" Link="Library/KernelMath.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyToUnityPackage" AfterTargets="Build" Condition="'$(CopyToUnityPackage)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KernelsRuntimeDirectory)Analyzers" />
  </Target>
</Project>
